HELIUS_API_KEY=your_helius_key_here
HELIUS_API_KEY_2=CHANGEME_optional_second_key
HELIUS_API_KEY_3=CHANGEME_optional_third_key
TELEGRAM_BOT_TOKEN=123456:AA-dummy-token
TELEGRAM_CHAT_ID=DemoChannelId
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
ALERT_CHANNEL=telegram
GEMINI_API_KEY=your_gemini_key_here

# Base / EVM read adapter (opt-in via: clusterdetect scan --chain base).
# Leave EVM_RPC_URL unset to use the free public Base RPC, or BYO a faster one.
EVM_RPC_URL=https://mainnet.base.org
# Inbound webhook receiver shared secret (clusterdetect webhook). No default:
# unset = every request is rejected.
WEBHOOK_SECRET=CHANGEME_webhook_shared_secret

CLUSTER_MIN_WALLETS=3
CLUSTER_WINDOW_MINUTES=15
CLUSTER_MIN_TOTAL_SCORE=6
MIN_BUY_USD=0
POLL_INTERVAL_SECONDS=60
POLL_SIGS_PER_WALLET=5
HELIUS_RPS=6
HELIUS_DAILY_BUDGET=95000
ALERT_COOLDOWN_MINUTES=60
PUMPFUN_GRADUATION=false
GEMINI_ENABLED=false
GEMINI_MAX_CALLS_PER_DAY=0
GEMINI_MIN_CLUSTER_SCORE=8
